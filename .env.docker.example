# Environment variables for Docker / Portainer
#
# Portainer (Git repository stack):
#   1. Build method: Repository
#   2. Compose path: docker-compose.yml
#   3. Paste the variables below into: Stack → Environment variables
#      (one KEY=value per line; do not commit real secrets to Git)
#
# Local:
#   cp .env.docker.example .env.docker
#   # fill secrets, then:
#   docker compose --env-file .env.docker up -d --build
#
# DB_PASSWORD and MARIADB_PASSWORD must match.

APP_NAME=Bolao26
APP_ENV=production
# Required at runtime (Portainer stack env). Never baked into the Docker image.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_PORT=3306
DB_DATABASE=bolao26
DB_USERNAME=bolao26
DB_PASSWORD=change-me

MARIADB_DATABASE=bolao26
MARIADB_USER=bolao26
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Bolao26

VITE_APP_NAME=Bolao26

FIFA_API_BASE_URL=https://api.fifa.com/api/v3
FIFA_SEASON_ID=285023
FIFA_API_LANGUAGE=en
FIFA_API_MATCH_COUNT=500
FIFA_API_TIMEOUT=15
FIFA_API_CONNECT_TIMEOUT=5
FIFA_SYNC_INTERVAL_HOURS=6
FIFA_RESULTS_SYNC_MINUTES=15

REGISTRATION_INVITE_CODE=

APP_PORT=8080
